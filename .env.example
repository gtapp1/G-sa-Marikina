# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real keys.

# ---- Supabase Postgres (Drizzle connection) ----
# Supabase dashboard → Project Settings → Database → Connection string → "URI"
# Use the connection pooler URI (port 6543) for serverless/Vercel.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-region.pooler.supabase.com:6543/postgres"

# ---- Clerk (auth) ----
# Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# Clerk webhook signing secret (Clerk dashboard → Webhooks → your endpoint → Signing Secret)
CLERK_WEBHOOK_SECRET="whsec_xxx"

# Clerk redirect URLs (optional overrides)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ---- Cloudinary (image uploads, Phase 2 photo reviews) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="xxx"
CLOUDINARY_API_SECRET="xxx"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
